# Convex deployment URL from `npx convex dev` (or the anonymous local
# deployment it configures without an account).
NEXT_PUBLIC_CONVEX_URL=

# Shared secret sent with internal Convex query/mutation calls, checked by
# the internalToken-gated functions in convex/connectors.ts against the
# deployment's own env var of the same name. Kept optional at the
# env-validation layer so `next build` succeeds with no config; the server
# Convex client guards its absence at the request boundary with a clear
# runtime error instead of failing the build.
CONVEX_INTERNAL_TOKEN=

# Base URL of the always-on gateway the web app forwards connector RPCs and
# status lookups to (http://localhost:4650 in dev; the deployed gateway
# origin in production).
GATEWAY_URL=

# Shared secret for the gateway's /internal/* API, sent as a Bearer token.
# Must match the GATEWAY_INTERNAL_TOKEN the gateway process runs with.
GATEWAY_INTERNAL_TOKEN=

# User auth (@convex-dev/auth) also needs JWT_PRIVATE_KEY and JWKS set on the
# Convex deployment itself (not here) — run `npx @convex-dev/auth` once to
# generate and set them. Sign-up is open only until the first user exists;
# after that, ask an existing user to invite you (no in-app invite flow yet).
