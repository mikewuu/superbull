# Convex deployment URL from `npx convex dev` (or the anonymous local
# deployment it configures without an account).
NEXT_PUBLIC_CONVEX_URL=

# Shared secret the hub sends with every Convex query/mutation call, checked
# by convex/proxySources.ts against the deployment's own env var of the same
# name. Kept optional at the env-validation layer so `next build` succeeds
# with no config; the server Convex client guards its absence at the request
# boundary with a clear runtime error instead of failing the build.
CONVEX_INTERNAL_TOKEN=

# Bearer token remote proxies (and the hub's own API) authenticate with.
HUB_API_TOKEN=
