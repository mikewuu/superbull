# Which HubDatabase adapter to use. Defaults to "memory" (zero-config, in-process, non-persistent).
HUB_DATABASE=memory

# Required when HUB_DATABASE=postgres. Read via pg-connection-from-env.
DATABASE_URL=

# Required when HUB_DATABASE=convex. NEXT_PUBLIC_CONVEX_URL is the deployment URL from `npx convex dev`.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_INTERNAL_TOKEN=

# Bearer token remote proxies (and the hub's own API) authenticate with.
# Kept optional at the env-validation layer so `next build` succeeds with no
# config beyond the memory-mode default; phase 2 guards its absence at the
# request boundary with a clear runtime error instead of failing the build.
HUB_API_TOKEN=
