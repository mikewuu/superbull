{
  "name": "@bullwatch/express",
  "version": "0.0.0",
  "description": "Express server adapter for the bullwatch BullMQ dashboard",
  "keywords": ["bullmq", "dashboard", "monitoring", "queue", "redis", "express"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikewu/bullwatch.git",
    "directory": "packages/express"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bullwatch/api": "workspace:*",
    "ejs": "^6.0.1"
  },
  "peerDependencies": {
    "express": ">=4.17.0"
  },
  "devDependencies": {
    "@bullwatch/test-utils": "workspace:*",
    "@bullwatch/tsconfig": "workspace:*",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "bullmq": "^5.34.0",
    "express": "^5.2.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
