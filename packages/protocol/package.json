{
  "name": "@superbull/protocol",
  "version": "0.0.0",
  "description": "Typed WebSocket frame protocol shared by the SuperBull gateway and connector",
  "keywords": ["bullmq", "dashboard", "monitoring", "queue", "redis"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikewu/superbull.git",
    "directory": "packages/protocol"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@superbull/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
