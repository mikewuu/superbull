{
  "name": "@superbull/hono",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "description": "Hono server adapter for the superbull BullMQ dashboard",
  "keywords": ["bullmq", "dashboard", "monitoring", "queue", "redis", "hono"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikewu/superbull.git",
    "directory": "packages/hono"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@superbull/api": "workspace:*",
    "ejs": "^6.0.1"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@superbull/test-utils": "workspace:*",
    "@superbull/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "bullmq": "^5.34.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/ejs": "^3.1.5",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.0"
  }
}
